[Unit]
Description=RunAPI
After=network.target

[Service]
# 工作目录必须是安装目录,程序按相对路径找 config/ 和 frontend/*/dist
WorkingDirectory=@INSTALL_DIR@
ExecStart=@INSTALL_DIR@/runapi
# 敏感配置(如邮箱授权码)放到该文件,形如:RUNAPI_EMAIL__PASSWORD=xxx
# 前缀 - 表示文件不存在也不报错
EnvironmentFile=-@INSTALL_DIR@/runapi.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
