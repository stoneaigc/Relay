# Relay 环境变量模板:复制为 .env 使用(.env 已被 .gitignore 排除,不会提交)。
# 命名规则:前缀 RELAY_,`__` 分隔配置层级。
# 加载优先级:进程环境变量 > .env > config/default.toml。

# ---- 服务 ----
# RELAY_SERVER__BIND=0.0.0.0:8080

# ---- 管理后台凭据(生产必改)----
# RELAY_ADMIN__USERNAME=admin
# RELAY_ADMIN__PASSWORD=change-me

# ---- JWT 签名密钥(生产必改,建议长随机串)----
# RELAY_AUTH__JWT_SECRET=change-me-to-a-long-random-string

# ---- 数据库(type=sqlite 或 postgres)----
# RELAY_DATABASE__TYPE=sqlite
# RELAY_DATABASE__URL=sqlite://relay.db?mode=rwc
# Postgres 分项示例(url 为空时生效;密码含 @ ! / # 等特殊字符无需转义):
# RELAY_DATABASE__TYPE=postgres
# RELAY_DATABASE__HOST=127.0.0.1
# RELAY_DATABASE__PORT=5432
# RELAY_DATABASE__USER=postgres
# RELAY_DATABASE__PASSWORD=your-pg-password
# RELAY_DATABASE__DBNAME=relay

# ---- 缓存(type=memory 或 redis)----
# RELAY_CACHE__TYPE=redis
# RELAY_CACHE__URL=redis://127.0.0.1:6379
# RELAY_CACHE__PASSWORD=your-redis-password

# ---- 请求链路日志后端与 Elasticsearch ----
# RELAY_LOGGING__STORE=elasticsearch
# RELAY_LOGGING__ELASTICSEARCH_URL=http://127.0.0.1:9200
# RELAY_LOGGING__ELASTICSEARCH_INDEX_PREFIX=relay-logs
# RELAY_LOGGING__ELASTICSEARCH_USERNAME=
# RELAY_LOGGING__ELASTICSEARCH_PASSWORD=your-es-password

# ---- SMTP 邮件(smtp_host 空 = 开发模式)----
# RELAY_EMAIL__SMTP_HOST=smtp.example.com
# RELAY_EMAIL__SMTP_PORT=587
# RELAY_EMAIL__USERNAME=
# RELAY_EMAIL__PASSWORD=
# RELAY_EMAIL__FROM=

# ---- Prometheus /metrics 导出令牌(空 = 仅管理端 JWT 可访问)----
# RELAY_METRICS__EXPORT_TOKEN=change-me
